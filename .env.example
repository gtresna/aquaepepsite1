# Salin menjadi .env (untuk lokal) atau isi di dashboard hosting sebagai Environment Variables.
ADMIN_PASSWORD=GantiDenganPasswordKuatAnda
SESSION_SECRET=isi-dengan-string-acak-minimal-32-karakter
# Arahkan ke disk/volume permanen di hosting (contoh: /data). Kosongkan untuk memakai folder ./data
DATA_DIR=
